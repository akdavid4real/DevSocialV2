#!/bin/sh
# Sourced by the official nginx entrypoint before template expansion.
export DNS_RESOLVER="${DNS_RESOLVER:-$(awk '/^nameserver / { print $2; exit }' /etc/resolv.conf)}"
: "${DNS_RESOLVER:?No DNS resolver configured}"
case "$API_UPSTREAM" in
    http://*|https://*) ;;
    *) echo 'API_UPSTREAM must start with http:// or https://' >&2; exit 1 ;;
esac
