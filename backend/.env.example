# Server Configuration
PORT=3000
NODE_ENV=development
# Optional single test email allowed by POST /api/v2/auth/dev/verify.
# Disabled unless NODE_ENV is development and the email matches exactly.
DEV_AUTH_TEST_EMAIL=

# Database (Supabase Postgres)
# On IPv4-only Docker networks, copy Supabase Connect > Session pooler (port 5432).
# It uses postgres.<project-ref> as the username and a pooler.supabase.com host.
# Direct db.<project-ref>.supabase.co connections normally require IPv6.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Supabase (Admin SDK)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser origins allowed to call the API.
# FRONTEND_URL is always included; add comma-separated extra origins as needed.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# Web refresh-session cookie.
# Use "none" only when frontend/API are truly cross-site; HTTPS is required.
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

# Authentication uses Supabase access tokens directly.
# Configure an appropriately short JWT expiry in Supabase Auth settings.

# Browser Web Push (VAPID).
# Generate one VAPID keypair and keep the private key server-side only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Expo Push (native mobile).
# Optional unless your Expo project has push security enabled.
EXPO_PUSH_ACCESS_TOKEN=

# Transactional / digest email delivery through Resend.
# EMAIL_FROM must use a sender/domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=DevSocial <notifications@your-domain.com>
