# Public browser configuration only. Use the same Supabase project as backend/.env.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Optional browser push key (never the private key).
VITE_VAPID_PUBLIC_KEY=

# Optional: allow local email-verification bypass for this one test account.
# Leave blank to disable. Never used when NODE_ENV is production.
DEV_AUTH_TEST_EMAIL=
