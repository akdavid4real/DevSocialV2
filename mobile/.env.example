# DevSocial mobile API. Required for preview/production builds.
# Example: https://api.example.com/api/v2
EXPO_PUBLIC_API_URL=

# Supabase public project values used for authenticated Realtime.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# EAS project ID used to obtain Expo push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=
